<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Non accordable par l'utilisateur : passer par
         adb shell pm grant com.deltawaken.adbtiles android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Sockets locales vers l'adbd du téléphone même. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Savoir si un Wi-Fi est connecté : le débogage sans fil l'exige. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Demander l'exemption d'optimisation de batterie : en veille, Android coupe le réseau de
         l'app, y compris vers 127.0.0.1, et la tuile TCP/IP ne voit plus adbd. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Rendre le port TCP à l'état d'avant le redémarrage : adbd ne le fait pas
         (`service.adb.tcp.port` est du runtime, `persist.adb.tcp.port` n'est pas écrivable par une
         app). Chemin de SECOURS seulement — voir Restore : les ROM qui filtrent les diffusions ne
         le livrent pas, et c'est la liaison des tuiles par SystemUI qui fait le travail. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <service
            android:name=".UsbDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_usb_debug"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".TcpipTileService"
            android:exported="true"
            android:icon="@drawable/ic_tcpip_debug"
            android:label="@string/tcpip_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Non exporté : seul le système émet ces diffusions protégées. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <!-- ⛔ PAS de LOCKED_BOOT_COMPLETED : il n'est livré qu'aux composants
                 directBootAware, et nos préférences sont en stockage chiffré par identifiant —
                 avant déverrouillage, isDesiredOpen() lirait « faux » et on ne restaurerait rien.
                 Le déclarer donnerait une ligne qui ne peut pas fonctionner. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
